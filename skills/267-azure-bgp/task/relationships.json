      "propagates_to": ["defaultRouteTable"],
      "propagation_labels": []
    },
    {
      "name": "app-west",
      "hub": "hub-west",
      "route_table_association": "defaultRouteTable",
      "propagates_to": ["defaultRouteTable"],
      "propagation_labels": []
    }
  ],
  "branch_connections": [
    {
      "name": "conn-site-sg",
      "hub": "hub-west",
